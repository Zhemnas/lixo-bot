# Painel admin
ADMIN_USER=admin
# Obrigatoria: minimo 10 caracteres. Sem ela o painel nao sobe.
ADMIN_PASSWORD=
# 127.0.0.1 = so acessivel na propria maquina. No Docker o compose ja sobrescreve para 0.0.0.0
# (a porta publicada continua presa em 127.0.0.1 no host).
ADMIN_HOST=127.0.0.1
ADMIN_PORT=3000

# Onde fica o SQLite
DATA_DIR=./data

# Fuso usado em toda a logica de datas
APP_TZ=America/Sao_Paulo

# Telegram (Bot API oficial, long polling: nao precisa de URL publica/HTTPS)
# false = sobe so o painel/agendador, sem conectar no Telegram (util para testar)
TELEGRAM_ENABLED=true
# Token do @BotFather. Obrigatorio com TELEGRAM_ENABLED=true. Nunca commitar.
TELEGRAM_BOT_TOKEN=

# Intervalo minimo entre envios/edicoes de mensagem (ms). 429 do Telegram e respeitado automaticamente.
SEND_MIN_INTERVAL_MS=1100

LOG_LEVEL=info
