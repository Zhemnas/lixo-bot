{
  "name": "lixo-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Bot de Telegram para rodizio de recolhimento do lixo do escritorio",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "npm run build && node dist/index.js"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "express": "5.3.0",
    "grammy": "1.46.0",
    "node-cron": "4.2.1",
    "pino": "9.14.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "5.0.3",
    "@types/node": "20.19.43",
    "typescript": "5.9.3"
  }
}
